rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Org config (membership counter) ──
    // Fixed: HIGH-01 Overly Permissive Firestore Rule on /org/{docId} as per audit
    // Any authenticated user can read; only officers/admins can directly write,
    // except for self-registration which is restricted to incrementing memberCounter by exactly +1
    match /org/{docId} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
        && (
          isOfficerOrAbove()
          || (
            (docId == 'memberCounter' || docId == 'partnerCounter')
            && (
              (!exists(/databases/$(database)/documents/org/$(docId)) && request.resource.data.count == 1)
              || (exists(/databases/$(database)/documents/org/$(docId)) && request.resource.data.count == resource.data.count + 1)
            )
          )
        );
    }

    // ── Members ──
    match /members/{uid} {
      // Fixed: HIGH-03 Removed Public Read Access to Member PII
      // Authenticated users can read their own profile (by UID or email), officers/admins/partners can read any profile.
      allow get: if request.auth != null && (
        request.auth.uid == uid
        || (resource != null && resource.data.get('email', '').lower() == request.auth.token.email.lower())
        || isOfficerOrAbove()
        || isPartner()
      );

      // Allow listing/searching all members for officers, admins, partners, or querying own record by email
      allow list: if request.auth != null && (
        isOfficerOrAbove()
        || isPartner()
        || (resource != null && resource.data.get('email', '').lower() == request.auth.token.email.lower())
      );

      // ── SELF-REGISTRATION ──
      // Fixed: MED-01 Server-side input validation on registration as per audit
      // Any authenticated user can create their OWN member doc.
      // - Students must have role='member', status='pending', valid fullName, valid studentId
      // - Partners must have role='partner', status='pending', valid fullName (business name)
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() > 0
        && request.resource.data.fullName.size() <= 100
        && (
          (
            // Whitelisted Admins
            isWhitelistedAdmin()
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active'
          ) || (
            // Regular Students & Partners
            (
              request.auth.token.email.lower().matches('.*@g\\.batstate-u\\.edu\\.ph') ||
              isWhitelistedAdmin()
            )
            && request.resource.data.status == 'pending'
            && (
              (
                request.resource.data.role == 'member'
                && request.resource.data.studentId is string
                && request.resource.data.studentId.matches('^([0-9]{2}|[0-9]{4})-[0-9]{5}$')
              ) || (
                request.resource.data.role == 'partner'
                // Optional: add other checks for partners, e.g. contactPerson, businessType
              )
            )
          )
        );

      // Fixed: SEC-TICKET-01 Members must submit a correction ticket rather than mutating verified profile fields directly.
      // Only allow initial UID-linking when a CSV-imported record is claimed by matching email.
      allow update: if request.auth != null
        && resource != null
        && resource.data.get('email', '').lower() == request.auth.token.email.lower()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid', 'photoURL']);

      // Fixed: MED-02 Prevent Officer-to-Admin Privilege Escalation as per audit
      // Officers can update members (e.g. approve/deactivate/edit details), but ONLY admins can change the 'role' field
      allow update: if request.auth != null
        && isOfficerOrAbove()
        && (
          isAdmin()
          || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        );

      // Only admins can delete
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Correction Tickets ──
    match /tickets/{ticketId} {
      // Students can read their own tickets; Officers/Admins can read all tickets
      allow get, list: if request.auth != null && (
        isOfficerOrAbove()
        || (resource != null && resource.data.uid == request.auth.uid)
      );

      // Students (pending or active) can create a ticket for their own profile with all 5 detail fields validated
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.category == 'edit_details'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.proposedChanges is map
        && request.resource.data.proposedChanges.fullName is string
        && request.resource.data.proposedChanges.fullName.size() > 0
        && request.resource.data.proposedChanges.fullName.size() <= 100
        && request.resource.data.proposedChanges.studentId is string
        && request.resource.data.proposedChanges.studentId.matches('^([0-9]{2}|[0-9]{4})-[0-9]{5}$')
        && request.resource.data.proposedChanges.department is string
        && request.resource.data.proposedChanges.department.size() > 0
        && request.resource.data.proposedChanges.program is string
        && request.resource.data.proposedChanges.program.size() > 0
        && request.resource.data.proposedChanges.yearLevel is string
        && request.resource.data.proposedChanges.yearLevel.size() > 0;

      // Students can cancel their own pending ticket; Officers/Admins can approve or reject tickets
      allow update: if request.auth != null && (
        (
          resource.data.uid == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt'])
        )
        || isOfficerOrAbove()
      );

      // Only admins can delete tickets
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Helpers ──
    function isWhitelistedAdmin() {
      return request.auth != null
        && request.auth.token.email.lower() in ['sscalangilan.storage@gmail.com', 'paala.luke24@gmail.com'];
    }

    // Safe lookup — returns empty map if doc doesn't exist (avoids permission errors)
    function getMemberRole() {
      let docRef = /databases/$(database)/documents/members/$(request.auth.uid);
      return exists(docRef) ? get(docRef).data.get('role', 'member') : 'member';
    }

    function isOfficerOrAbove() {
      return isWhitelistedAdmin() || getMemberRole() == 'officer' || getMemberRole() == 'admin';
    }

    function isAdmin() {
      return isWhitelistedAdmin() || getMemberRole() == 'admin';
    }

    function isPartner() {
      return getMemberRole() == 'partner';
    }
  }
}
